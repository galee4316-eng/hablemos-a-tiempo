  <style>
    :root {
      --bg: #f3f5ff;
      --surface: #ffffff;
      --ink: #161b45;
      --muted: #4a5080;
      --line: #d5daf2;
      --brand: #1b2559;
      --on-brand: #ffffff;
      --glow: #ffc857;
      --on-glow: #161b45;
      --calm: #1f8a8a;
      --bubble-a: #dfe6ff;
      --bubble-b: #1b2559;
      --bubble-b-ink: #ffffff;
      box-sizing: border-box;
    }
    [data-theme="dark"] {
      --bg: #0e1230;
      --surface: #171d4a;
      --ink: #eef0ff;
      --muted: #b4bbe6;
      --line: #2c3569;
      --brand: #ffc857;
      --on-brand: #161b45;
      --glow: #ffc857;
      --on-glow: #161b45;
      --calm: #58c4c4;
      --bubble-a: #232b63;
      --bubble-b: #ffc857;
      --bubble-b-ink: #161b45;
    }
    *, *::before, *::after { box-sizing: inherit; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: 'Nunito Sans', system-ui, -apple-system, sans-serif;
      font-size: 1.05rem;
      line-height: 1.6;
      transition: background 0.2s, color 0.2s;
    }
    h1, h2, h3, h4 {
      font-family: 'Bricolage Grotesque', system-ui, sans-serif;
      line-height: 1.15;
      margin: 0 0 0.5em;
      letter-spacing: -0.01em;
    }
    h1 { font-size: clamp(2.2rem, 6vw, 3.8rem); font-weight: 800; }
    h2 { font-size: clamp(1.6rem, 4vw, 2.4rem); font-weight: 800; }
    h3 { font-size: 1.25rem; font-weight: 700; }
    p { margin: 0 0 1em; }
    a { color: inherit; }
    .wrap { width: min(1120px, 100% - 2.5rem); margin-inline: auto; }
    
    /* Header */
    header.top {
      position: sticky;
      top: 0;
      z-index: 40;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      backdrop-filter: blur(8px);
    }
    header.top .wrap {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
      min-height: 64px;
      flex-wrap: wrap;
    }
    .logo {
      font-family: 'Bricolage Grotesque', sans-serif;
      font-weight: 800;
      text-decoration: none;
      font-size: 1.25rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .logo-badge {
      width: 2rem;
      height: 2rem;
      border-radius: 50%;
      background: var(--brand);
      color: var(--glow);
      display: grid;
      place-items: center;
      font-size: 0.85rem;
      font-weight: 800;
    }
    [data-theme="dark"] .logo-badge {
      background: var(--glow);
      color: var(--on-glow);
    }
    nav { display: flex; gap: 1.5rem; flex-wrap: wrap; }
    nav a {
      text-decoration: none;
      color: var(--muted);
      font-weight: 700;
      font-size: 0.95rem;
    }
    nav a:hover { color: var(--ink); text-decoration: underline; }
    
    /* Botones */
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: var(--on-glow);
      color: var(--glow);
      font-weight: 700;
      text-decoration: none;
      padding: 0.75rem 1.4rem;
      border-radius: 999px;
      border: 0;
      cursor: pointer;
      font: 700 0.95rem 'Nunito Sans', sans-serif;
      transition: transform 0.15s, opacity 0.15s;
    }
    .btn:hover { opacity: 0.92; transform: translateY(-1px); }
    .btn.alt { background: var(--brand); color: var(--on-brand); }
    .btn.outline { background: transparent; border: 1px solid var(--line); color: var(--ink); }
    .btn.sm { padding: 0.5rem 1rem; font-size: 0.85rem; }
    
    /* Hero */
    .hero { padding: clamp(2.5rem, 6vw, 4.5rem) 0; }
    .hero-grid { display: grid; gap: 3rem; grid-template-columns: 1.2fr 0.8fr; align-items: center; }
    .lead { font-size: 1.25rem; color: var(--muted); line-height: 1.5; }
    .call-box {
      margin-top: 1.5rem;
      background: var(--glow);
      color: var(--on-glow);
      border-radius: 1.4rem;
      padding: 1.5rem 1.8rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
      box-shadow: 0 4px 14px rgba(27,37,89,0.08);
    }
    .call-row { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; }
    .call-num { font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: clamp(2.2rem, 5vw, 3.2rem); line-height: 1; }
    .call-desc { font-size: 0.95rem; font-weight: 700; margin-top: 0.3rem; }
    
    /* Chat preview */
    .chat-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 1.5rem;
      padding: 1.5rem;
      box-shadow: 0 4px 20px rgba(0,0,0,0.03);
    }
    .chat { display: grid; gap: 0.8rem; margin: 1rem 0; }
    .b { padding: 0.85rem 1.1rem; border-radius: 1.2rem; max-width: 88%; font-weight: 600; font-size: 0.95rem; line-height: 1.4; }
    .b.a { background: var(--bubble-a); border-bottom-left-radius: 0.3rem; justify-self: start; color: var(--ink); }
    .b.r { background: var(--bubble-b); color: var(--bubble-b-ink); border-bottom-right-radius: 0.3rem; justify-self: end; }
    
    /* Secciones */
    section { padding: clamp(2.5rem, 5vw, 4rem) 0; }
    .alt-bg { background: var(--surface); border-block: 1px solid var(--line); }
    .cols-3 { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
    .card { background: var(--surface); border: 1px solid var(--line); border-radius: 1.2rem; padding: 1.4rem; }
    .alt-bg .card { background: var(--bg); }
    
    /* Señales */
    ul.signs { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
    ul.signs li {
      padding: 1.1rem 1.2rem;
      border-left: 5px solid var(--calm);
      background: var(--surface);
      border-radius: 0.6rem;
      border-top: 1px solid var(--line);
      border-right: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
      font-weight: 600;
    }
    
    /* Pasos */
    ol.steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.2rem; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); counter-reset: s; }
    ol.steps li {
      counter-increment: s;
      background: var(--bg);
      border: 1px solid var(--line);
      border-radius: 1.2rem;
      padding: 1.4rem;
    }
    ol.steps li::before {
      content: counter(s);
      display: grid;
      place-items: center;
      width: 2.2rem;
      height: 2.2rem;
      border-radius: 50%;
      background: var(--brand);
      color: var(--on-brand);
      font-weight: 800;
      margin-bottom: 0.8rem;
    }
    
    /* Afiche */
    .poster-wrap { display: grid; gap: 2rem; grid-template-columns: minmax(0, 430px) 1fr; align-items: start; }
    .poster {
      --p-bg: #1b2559;
      --p-ink: #ffffff;
      --p-glow: #ffc857;
      --p-dark: #161b45;
      background: var(--p-bg);
      color: var(--p-ink);
      border-radius: 1.5rem;
      padding: 2.2rem 2rem;
      aspect-ratio: 210/297;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 1.2rem;
      box-shadow: 0 10px 30px rgba(0,0,0,0.15);
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    .poster h3 { font-size: clamp(2rem, 5vw, 2.6rem); font-weight: 800; margin: 0; line-height: 1.1; }
    .poster .sub { font-size: 1.1rem; margin: 0.5rem 0 0; }
    .poster .big { background: var(--p-glow); color: var(--p-dark); border-radius: 1.2rem; padding: 1.2rem 1.4rem; }
    .poster .big b { font-family: 'Bricolage Grotesque', sans-serif; font-size: clamp(2.4rem, 6vw, 3.4rem); font-weight: 800; display: block; line-height: 1; }
    .poster .big span { font-weight: 800; font-size: 0.9rem; text-transform: uppercase; }
    .poster .qr {
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 1rem;
      padding: 1rem;
      display: flex;
      gap: 1.2rem;
      align-items: center;
    }
    .qrbox { background: #fff; padding: 8px; border-radius: 0.8rem; line-height: 0; flex: none; }
    .poster .legal { font-size: 0.75rem; opacity: 0.85; margin: 0; }
    
    .tools-card { background: var(--surface); border: 1px solid var(--line); border-radius: 1.4rem; padding: 1.8rem; }
    .tools-card label { display: block; font-weight: 700; margin-bottom: 0.4rem; font-size: 0.95rem; }
    .tools-card input {
      width: 100%;
      padding: 0.8rem 1rem;
      border: 1px solid var(--line);
      border-radius: 0.7rem;
      background: var(--bg);
      color: var(--ink);
      font: inherit;
      font-size: 0.95rem;
    }
    
    footer { padding: 3rem 0; border-top: 1px solid var(--line); color: var(--muted); font-size: 0.95rem; }
    
    @media (max-width: 860px) {
      .hero-grid, .poster-wrap { grid-template-columns: 1fr; }
    }
    
    /* Imprimir sólo el afiche en hoja A4 */
    @media print {
      @page { size: A4 portrait; margin: 0; }
      body { background: #fff !important; }
      header.top, .hero, section:not(#afiche), footer, .tools-card, #afiche .head, .no-print { display: none !important; }
      #afiche { padding: 0 !important; }
      #afiche .wrap { width: 100% !important; margin: 0 !important; }
      .poster-wrap { display: block !important; }
      .poster {
        border-radius: 0 !important;
        width: 210mm !important;
        height: 297mm !important;
        padding: 20mm !important;
        box-shadow: none !important;
      }
    }
  </style>
</head>
<body>

  <!-- Cabecera -->
  <header class="top">
    <div class="wrap">
      <a class="logo" href="#inicio">
