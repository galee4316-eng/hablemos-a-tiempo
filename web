  <!-- Motor de Código QR -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <script>
    (function(){
      var input = document.getElementById('url-input');
      var box = document.getElementById('qr-poster');
      var printBtn = document.getElementById('print-btn');
      var copyBtn = document.getElementById('copy-btn');
      var resetBtn = document.getElementById('reset-btn');
      var themeBtn = document.getElementById('theme-btn');

      // Enlace público real
      var defaultUrl = 'https://ais-pre-gzm4vgylmt2qcu3klo3s3w-901573959576.us-east1.run.app';
      
      try {
        var cur = location.origin + location.pathname;
        if (cur.startsWith('http') && !cur.includes('localhost') && !cur.includes('ais-dev-')) {
          defaultUrl = cur;
        }
      } catch(e) {}

      input.value = defaultUrl;

      function renderQR() {
        var text = input.value.trim() || defaultUrl;
        box.innerHTML = '';
        if (!window.QRCode) {
          box.textContent = 'QR';
          return;
        }
        try {
          new QRCode(box, {
            text: text,
            width: 120,
            height: 120,
            colorDark: '#161b45',
            colorLight: '#ffffff',
            correctLevel: QRCode.CorrectLevel.M
          });
        } catch(err) {
          box.textContent = 'QR';
        }
      }

      input.addEventListener('input', renderQR);
      window.addEventListener('load', renderQR);

      printBtn.addEventListener('click', function(){
        window.print();
      });

      copyBtn.addEventListener('click', function(){
        navigator.clipboard.writeText(input.value);
        copyBtn.textContent = '✅ ¡Copiado!';
        setTimeout(function(){ copyBtn.textContent = '📋 Copiar enlace'; }, 2000);
      });

      resetBtn.addEventListener('click', function(){
        input.value = defaultUrl;
        renderQR();
      });

      themeBtn.addEventListener('click', function(){
        var current = document.documentElement.getAttribute('data-theme');
        if (current === 'dark') {
          document.documentElement.removeAttribute('data-theme');
        } else {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      });
    })();
  </script>
